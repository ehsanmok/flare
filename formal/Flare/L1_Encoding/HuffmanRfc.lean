theorem rfc_syms : RFC_B.map (·.1) = List.range 257 := by decide +kernel

theorem rfc_bits_hex : ∀ e ∈ RFC_B, 5 ≤ e.2.2 ∧ e.2.2 ≤ 30 ∧ e.2.1 < 2 ^ e.2.2 := by decide +kernel

/-- flare's Huffman table is exactly RFC 7541 Appendix B. -/
theorem TBL_eq_rfc : TBL = RFC_B.map (·.2) := by decide +kernel

